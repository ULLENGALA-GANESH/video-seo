# The API serves the built frontend and the API from the same origin.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=video_seo_db

# Set APP_ORIGIN to the public HTTPS origin in production.
# HTTPS origins automatically use Secure session cookies.
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true

# For multiple API processes, set this to false and run python worker.py.
INLINE_WORKER=true
# MEDIA_ROOT=/var/lib/keyword-studio/media
# FFMPEG_BINARY=/usr/bin/ffmpeg
# FRONTEND_DIST=/app/frontend/dist
# Optional personal key for the Google Speech recognizer used for media uploads.
# Pasted transcripts and sample reports have no speech service dependency.
# GOOGLE_SPEECH_KEY=

# YouTube Data API v3 for on-demand public search evidence.
# YOUTUBE_API_KEY=
# YOUTUBE_RESEARCH_DAILY_LIMIT=60

# Enable the YouTube Data API v3 and YouTube Analytics API for connected channels.
# Register the exact callback URI on a Google OAuth Web application client.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/channel/oauth/callback
# Generate a stable Fernet key once per installation. See README.
# YOUTUBE_TOKEN_KEY=

# The metadata editor connects to a local Ollama model on the API machine.
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
